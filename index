<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Pemilihan Guru Idola SMP Telkom Padang</title>
<style>
:root{--navy:#07366d;--blue:#1267ad;--gold:#e6b84b;--bg:#f2f6fb;--ink:#18283d}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,sans-serif}
header{background:linear-gradient(120deg,#062d5b,#1474bd);color:#fff;text-align:center;padding:30px 16px 26px;border-bottom:5px solid var(--gold)}
header .tag{font-size:12px;letter-spacing:2px;color:#f7d982;font-weight:bold}h1{font-size:clamp(23px,4vw,36px);margin:10px 0 7px}header p{margin:0}
main{max-width:1100px;margin:24px auto;padding:0 16px}.nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
button{border:0;border-radius:9px;background:var(--blue);color:#fff;padding:11px 16px;font-weight:bold;cursor:pointer}button.alt{background:#e2ebf6;color:var(--navy)}button.red{background:#a52b2b}button:disabled{opacity:.5;cursor:not-allowed}
.panel{background:white;padding:20px;border-radius:16px;box-shadow:0 5px 22px #102c5014;margin-bottom:18px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(205px,1fr));gap:17px}
.candidate{background:#fff;border:1px solid #dce5ef;border-radius:15px;overflow:hidden;text-align:center;padding:14px;box-shadow:0 3px 10px #18385a0c}
.photo{width:100%;height:220px;object-fit:cover;border-radius:11px;background:#e7eef7}
.placeholder{height:220px;border-radius:11px;background:linear-gradient(145deg,#e8f0fa,#d5e4f5);display:grid;place-items:center;color:#52739a;font-size:54px}
.candidate h3{margin:12px 0 5px;color:var(--navy);font-size:18px}.candidate .desc{font-size:13px;color:#718096;margin:0 0 12px}
.note{font-size:13px;color:#68788d;line-height:1.5}.hidden{display:none!important}
label{display:block;font-size:13px;font-weight:bold;margin:9px 0 5px}input{width:100%;padding:10px;border:1px solid #cbd7e5;border-radius:8px}
.editor{display:grid;grid-template-columns:130px 1fr;gap:14px;align-items:start;border:1px solid #e1e8f0;padding:13px;border-radius:12px;margin:12px 0}
.preview{width:130px;height:150px;object-fit:cover;border-radius:9px;background:#e7eef7}.previewempty{width:130px;height:150px;border-radius:9px;background:#e7eef7;display:grid;place-items:center;color:#69809a}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.bar{height:12px;background:#e8eef5;border-radius:20px;overflow:hidden;margin-top:7px}.bar span{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--gold))}
.total{font-size:30px;font-weight:bold;color:var(--navy)}footer{text-align:center;color:#728198;font-size:12px;padding:20px}
@media(max-width:520px){.editor{grid-template-columns:1fr}.preview,.previewempty{width:100%;height:210px}}
</style></head>
<body>
<header><div class="tag">SMP TELKOM PADANG</div><h1>PEMILIHAN GURU IDOLA</h1><p>Tahun Ajaran 2026–2027</p></header>
<main>
<div class="nav"><button onclick="tab('vote')">Halaman Pemilihan</button><button class="alt" onclick="tab('result')">Hasil Suara</button><button class="alt" onclick="tab('admin')">Panel Panitia</button></div>
<section id="vote" class="panel"><div class="row"><div><h2 style="margin:0 0 6px">Pilih Guru Idola Anda</h2><div class="note">Perhatikan foto dan nama calon sebelum memberikan suara.</div></div><div class="note" id="voteStatus"></div></div><div id="candidateCards" class="cards" style="margin-top:18px"></div></section>
<section id="result" class="panel hidden"><div class="row"><div><h2 style="margin:0 0 5px">Rekapitulasi Hasil Pemilihan</h2><div class="note">Hasil suara yang tersimpan pada browser/perangkat ini.</div></div><button onclick="renderResults()">Perbarui hasil</button></div><div style="margin:16px 0"><div class="total" id="totalVotes">0</div><div class="note">Total suara masuk</div></div><div id="results"></div></section>
<section id="admin" class="panel hidden"><h2>Panel Panitia</h2><div id="loginBox"><label>PIN Panitia</label><input id="pin" type="password" placeholder="Masukkan PIN panitia" style="max-width:300px"><p><button onclick="login()">Masuk</button></p><div class="note">PIN awal: 1234</div></div>
<div id="adminBox" class="hidden"><h3>Kelola Foto dan Nama Calon</h3><p class="note">Isi nama setiap calon dan unggah foto. Gunakan foto potret yang jelas. Perubahan disimpan pada browser ini.</p><div id="editors"></div><button onclick="saveAll()">Simpan Nama dan Foto</button> <button class="alt" onclick="exportCSV()">Unduh Rekap CSV</button> <button class="red" onclick="resetVotes()">Reset Suara</button><p class="note">Simpan salinan foto asli. Jika browser/perangkat dihapus atau diganti, data lokal tidak otomatis berpindah.</p></div></section>
</main><footer>PEMILIHAN GURU IDOLA · SMP TELKOM PADANG</footer>
<script>
const CKEY='guruIdolaPhotoCandidates_v2',VKEY='guruIdolaPhotoVotes_v2',DKEY='guruIdolaPhotoVoted_v2';
const defaults=Array.from({length:5},(_,i)=>({name:'Nama Guru '+(i+1),desc:'Bakal Calon Guru Idola',photo:''}));
function candidates(){try{return JSON.parse(localStorage.getItem(CKEY))||defaults}catch(e){return defaults}}
function votes(){try{return JSON.parse(localStorage.getItem(VKEY))||[]}catch(e){return []}}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function tab(id){['vote','result','admin'].forEach(k=>document.getElementById(k).classList.toggle('hidden',k!==id));if(id==='vote')renderCards();if(id==='result')renderResults()}
function renderCards(){let c=candidates(),done=localStorage.getItem(DKEY)==='1';document.getElementById('voteStatus').textContent=done?'Suara dari browser ini sudah tercatat.':'Silakan pilih satu calon guru.';document.getElementById('candidateCards').innerHTML=c.map((x,i)=>`<article class="candidate">${x.photo?`<img class="photo" src="${x.photo}" alt="Foto ${esc(x.name)}">`:`<div class="placeholder"> ${i+1} </div>`}<h3>${esc(x.name)}</h3><p class="desc">${esc(x.desc)}</p><button ${done?'disabled':''} onclick="choose(${i})">${done?'Sudah Memilih':'Pilih Guru Ini'}</button></article>`).join('')}
function choose(i){if(localStorage.getItem(DKEY)==='1'){alert('Browser ini sudah mengirim suara.');return}let c=candidates();if(!confirm('Anda memilih '+c[i].name+'. Lanjutkan?'))return;let v=votes();v.push({candidate:i,time:new Date().toISOString()});localStorage.setItem(VKEY,JSON.stringify(v));localStorage.setItem(DKEY,'1');renderCards();alert('Terima kasih. Suara berhasil dicatat pada perangkat ini.')}
function renderResults(){let c=candidates(),v=votes(),n=c.map((_,i)=>v.filter(x=>x.candidate===i).length),max=Math.max(1,...n);document.getElementById('totalVotes').textContent=v.length;document.getElementById('results').innerHTML=c.map((x,i)=>`<div style="margin:19px 0"><div class="row"><b>${esc(x.name)}</b><b>${n[i]} suara (${v.length?Math.round(n[i]/v.length*100):0}%)</b></div><div class="bar"><span style="width:${n[i]/max*100}%"></span></div></div>`).join('')}
function login(){if(document.getElementById('pin').value!=='1234'){alert('PIN tidak sesuai.');return}document.getElementById('loginBox').classList.add('hidden');document.getElementById('adminBox').classList.remove('hidden');renderEditors()}
function renderEditors(){let c=candidates();document.getElementById('editors').innerHTML=c.map((x,i)=>`<div class="editor"><div id="preview${i}">${x.photo?`<img class="preview" src="${x.photo}" alt="Foto calon ${i+1}">`:`<div class="previewempty">Foto ${i+1}</div>`}</div><div><label>Nama calon ${i+1}</label><input id="name${i}" value="${esc(x.name)}" placeholder="Masukkan nama lengkap"><label>Keterangan (opsional)</label><input id="desc${i}" value="${esc(x.desc)}"><label>Unggah foto</label><input id="photo${i}" type="file" accept="image/*" onchange="previewFile(${i},this)"><button class="alt" type="button" onclick="clearPhoto(${i})">Hapus foto</button></div></div>`).join('')}
function previewFile(i,input){let f=input.files[0];if(!f)return;if(!f.type.startsWith('image/')){alert('Pilih file gambar.');input.value='';return}let reader=new FileReader();reader.onload=()=>{document.getElementById('preview'+i).innerHTML=`<img class="preview" src="${reader.result}" alt="Pratinjau foto">`;document.getElementById('preview'+i).dataset.photo=reader.result};reader.readAsDataURL(f)}
function clearPhoto(i){document.getElementById('preview'+i).dataset.photo='';document.getElementById('preview'+i).innerHTML='<div class="previewempty">Foto '+(i+1)+'</div>';let inp=document.getElementById('photo'+i);if(inp)inp.value=''}
function saveAll(){let old=candidates(),out=[];for(let i=0;i<5;i++){let p=document.getElementById('preview'+i),photo=p.dataset.photo!==undefined?p.dataset.photo:old[i].photo;out.push({name:document.getElementById('name'+i).value.trim()||'Nama Guru '+(i+1),desc:document.getElementById('desc'+i).value.trim(),photo})}try{localStorage.setItem(CKEY,JSON.stringify(out));alert('Nama dan foto calon berhasil disimpan.');renderEditors();renderCards()}catch(e){alert('Penyimpanan penuh. Coba gunakan foto berukuran lebih kecil.')}} 
function exportCSV(){let c=candidates(),v=votes(),count=c.map((_,i)=>v.filter(x=>x.candidate===i).length);let rows=[['No','Nama Guru','Jumlah Suara','Persentase'],...c.map((x,i)=>[i+1,x.name,count[i],v.length?(count[i]/v.length*100).toFixed(2)+'%':'0%'])];let csv='\ufeff'+rows.map(r=>r.map(x=>'"'+String(x).replace(/"/g,'""')+'"').join(',')).join('\r\n');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download='hasil_pemilihan_guru_idola.csv';a.click();URL.revokeObjectURL(a.href)}
function resetVotes(){if(!confirm('Hapus seluruh suara pada browser ini?'))return;localStorage.removeItem(VKEY);localStorage.removeItem(DKEY);renderResults();renderCards();alert('Suara lokal telah direset.')}
renderCards();
</script></body></html>
